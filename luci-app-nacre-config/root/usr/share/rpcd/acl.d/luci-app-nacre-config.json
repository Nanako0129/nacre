{
	"luci-app-nacre-config": {
		"description": "Grant access to nacre theme settings",
		"read": {
			"uci": [ "nacre" ]
		},
		"write": {
			"uci": [ "nacre" ],
			"cgi-io": [ "upload" ],
			"file": {
				"/tmp/nacre-upload.bin": [ "write" ]
			},
			"ubus": {
				"luci.nacre": [ "set_background", "clear_background" ]
			}
		}
	}
}
