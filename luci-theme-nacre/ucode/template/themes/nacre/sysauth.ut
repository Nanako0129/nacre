{#
 nacre login page. The form posts luci_username / luci_password straight to
 the dispatcher (same fields as bootstrap), without bootstrap's modal view.
 Copyright 2026 Nanako0129. Licensed to the public under the Apache License 2.0.
-#}

{%
	const boardinfo = ubus.call('system', 'board');
-%}

{#
 Include the theme header directly, not luci-base's 'header': the base one
 boots luci.js, which issues an unauthenticated uci/get (Access denied in the
 console). A plain form needs no JS runtime. argon does the same.
-#}
{% include('themes/nacre/header', { blank_page: true, login_page: true }) %}

<div id="nacre-login">
	<svg class="nacre-strata" viewBox="0 0 1280 800" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
		<path d="M0 250 C 220 190 420 300 640 250 S 1060 170 1280 230 L1280 800 L0 800 Z" class="s1"/>
		<path d="M0 360 C 260 300 470 420 700 370 S 1100 290 1280 350 L1280 800 L0 800 Z" class="s2"/>
		<path d="M0 470 C 240 430 500 520 760 470 S 1120 410 1280 460 L1280 800 L0 800 Z" class="s3"/>
		<path d="M0 560 C 300 520 520 610 800 565 S 1140 520 1280 560 L1280 800 L0 800 Z" class="s4"/>
		<path d="M0 640 C 260 610 540 690 820 650 S 1150 610 1280 640 L1280 800 L0 800 Z" class="s5"/>
		<path d="M0 720 C 280 700 560 760 840 725 S 1160 700 1280 720 L1280 800 L0 800 Z" class="s6"/>
	</svg>

	<main class="nacre-login-card">
		<div class="nacre-login-brand">
			<img src="{{ media }}/logo.svg" alt="" width="52" height="52">
			<span>nacre</span>
		</div>
		<div class="nacre-pills">
			<span class="nacre-pill sky">{{ striptags(boardinfo.hostname ?? '?') }}</span>
			<span class="nacre-pill sage">{{ striptags(boardinfo.release?.version ?? '') }}</span>
		</div>
		<h1>{{ _('Authorization Required') }}</h1>

		{% if (fuser): %}
		<div class="alert-message error" role="alert">
			{{ _('Invalid username and/or password! Please try again.') }}
		</div>
		{% endif %}

		<form method="post" class="nacre-login-form">
			<label for="luci_username">{{ _('Username') }}</label>
			<input name="luci_username" id="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}" required>
			<label for="luci_password">{{ _('Password') }}</label>
			<input name="luci_password" id="luci_password" type="password" autocomplete="current-password" autofocus>
			<button type="submit" class="nacre-login-submit">{{ _('Log in') }}</button>
		</form>
	</main>
</div>

{% include('themes/nacre/footer', { blank_page: true }) %}
