{#
 nacre — derived from luci-theme-bootstrap footer.
 Licensed to the public under the Apache License 2.0.
-#}

		{% if (!blank_page): %}
			</div>
			<footer id="nacre-footer">
				<span>
					<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a>
					·
					<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }}</a>
					{% if (lua_active): %}
						· {{ _('Lua compatibility mode active') }}
					{% endif %}
					· nacre
				</span>
				<ul class="breadcrumb" id="modemenu" style="display:none"></ul>
			</footer>
		</div>
		<script>L.require('menu-nacre')</script>
		{% if (join('/', ctx.path) == 'admin/status/overview'): %}
		<script>L.require('nacre-statusline')</script>
		{% endif %}
		{% endif %}
	</body>
</html>
